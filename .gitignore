__pycache__/
*.pyc
.pytest_cache/

# Graph pickles are large binary caches, not source -- see README's
# "Verification & Reproducibility" section. The small .meta.json sidecars
# (fetch timestamp, node/edge counts, data source) ARE tracked for
# provenance; only the heavy .pkl payloads are excluded.
results/graph_cache/*.pkl

# Everything else in results/ (figures, tables, JSON report, per-pair CSV)
# is small and IS meant to be committed for a self-contained, reviewable
# repo -- do not blanket-ignore results/.

*.bak
*.bak.*
